{
  "name": "kaomoji-app",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A fast, installable PWA kaomoji picker \u2014 copy & paste Japanese emoticons, text faces, emoji and symbols.",
  "homepage": "https://kaomoji.fyi",
  "repository": {
    "type": "git",
    "url": "https://github.com/gfrmin/kaomoji"
  },
  "author": "Guy Freeman (https://gfrm.in)",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && wrangler pages functions build --outdir=./.worker-build/",
    "preview": "astro preview",
    "astro": "astro",
    "migrate": "node scripts/migrate.mjs",
    "decompose": "node scripts/decompose.mjs",
    "galleries": "node scripts/build-galleries.mjs",
    "og-fonts": "python3 scripts/build-og-fonts.py",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.3.0",
    "@astrojs/solid-js": "^5.0.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "astro": "^7.3.3",
    "astro-og-canvas": "^0.11.1",
    "fuse.js": "^7.1.0",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@vite-pwa/astro": "^1.0.0",
    "wrangler": "^4.129.0"
  }
}
